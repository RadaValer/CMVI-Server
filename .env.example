# Copiază acest fișier ca ".env" (în folderul server) pentru rularea locală.
# Pe Render NU folosi fișierul: pune aceleași variabile în Environment.

# Baza de date MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cmv
DB_USER=cmv
DB_PASSWORD=schimba-ma
# sau, într-o singură linie:  DATABASE_URL=mysql://user:parola@host:3306/cmv

# Adresa site-ului (clientul) care are voie să folosească API-ul; mai multe, despărțite prin virgulă
CLIENT_ORIGIN=https://cmv-client.cleverapps.io

# Pe Render: 1 (cererile trec printr-un proxy). Local: 0.
TRUST_PROXY=0

# Mărimea maximă a unui fișier încărcat la noutăți, în MB
MAX_UPLOAD_MB=10

# Portul (Render îl setează singur)
PORT=5173

# 1 = arată detaliile erorilor în răspunsuri (doar local)
DEBUG=0
